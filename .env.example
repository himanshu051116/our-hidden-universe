VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key
VITE_FIRESTORE_DATABASE_ID=default
VITE_COUPLE_ACCESS_CODE=replace-with-a-private-shared-code
VITE_BIRTHDAY_DATE=2026-08-14T00:00:00+05:30

# ---------------------------------------------------------------------------
# SERVER-ONLY VARIABLES FOR /api/turn-credentials
# Never prefix these with VITE_. Never commit real credentials.
# ---------------------------------------------------------------------------

FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Comma-separated coturn endpoints. Include UDP/TCP and TURN-over-TLS when available.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp

# Must match coturn's static-auth-secret / TURN REST API shared secret.
TURN_SHARED_SECRET=replace-with-a-long-random-server-only-secret

# Optional.
TURN_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_CREDENTIAL_TTL_SECONDS=600

# Vercel Cron backup cleanup authentication
CRON_SECRET=replace-with-a-long-random-secret
