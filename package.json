{
  "name": "our-hidden-universe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test:call": "node --test tests/call-*.test.mjs",
    "call:preflight": "node scripts/call-preflight.mjs",
    "call:check": "npm run test:call && npm run call:preflight",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules/call-rules.test.mjs\"",
    "test:e2e:call": "playwright test tests/e2e/call-smoke.spec.js",
    "call:probe": "node scripts/call-live-probe.mjs",
    "call:full-check": "npm run call:check && npm run test:rules",
    "call:gate": "node scripts/call-deployment-gate.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "vite": "^7.1.2",
    "workbox-precaching": "^7.4.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^15.30.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}
