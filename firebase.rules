rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function coupleMember(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.auth.uid));
    }

    function roomHasMemberAfter(coupleId, userId) {
      return getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds is list
        && getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds.hasAny([userId]);
    }

    function validRoomCreate(coupleId) {
      return request.resource.data.keys().hasOnly([
          'code',
          'displayCode',
          'createdBy',
          'createdAt',
          'updatedAt',
          'memberIds',
          'memberCount'
        ])
        && request.resource.data.code == coupleId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberCount == 1;
    }

    function validLegacyMembershipMigration() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return signedIn()
        && !resource.data.keys().hasAny(['memberIds', 'memberCount'])
        && changed.hasOnly(['memberIds', 'memberCount', 'updatedAt'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= 2
        && request.resource.data.memberIds.hasAny([resource.data.createdBy])
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberCount == request.resource.data.memberIds.size();
    }

    function validSecondMemberJoin() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return signedIn()
        && resource.data.memberIds is list
        && resource.data.memberIds.size() == 1
        && !resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberCount == 2
        && changed.hasOnly(['memberIds', 'memberCount', 'updatedAt']);
    }

    function validMemberCreate(coupleId, userId) {
      return signedIn()
        && request.auth.uid == userId
        && roomHasMemberAfter(coupleId, userId)
        && request.resource.data.keys().hasOnly([
          'joinedAt',
          'role',
          'lastActiveAt',
          'isTyping',
          'displayName'
        ])
        && (
          (
            getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.createdBy == userId
            && request.resource.data.role == 'creator'
          )
          ||
          (
            getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.createdBy != userId
            && request.resource.data.role == 'partner'
          )
        );
    }

    function validMemberUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['lastActiveAt', 'isTyping', 'displayName'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.joinedAt == resource.data.joinedAt;
    }

    function validSeenState() {
      return request.resource.data.seenBy is list
        && request.resource.data.seenAtBy is map
        && request.resource.data.seenBy.hasAny([request.auth.uid]);
    }

    function validEncryptedPayload() {
      return request.resource.data.encrypted is map
        && request.resource.data.encrypted.keys().hasAll(['cipherText', 'iv', 'salt', 'algorithm', 'integrity'])
        && request.resource.data.encrypted.cipherText is string
        && request.resource.data.encrypted.iv is string
        && request.resource.data.encrypted.salt is string
        && request.resource.data.encrypted.integrity is string
        && request.resource.data.encrypted.algorithm == 'AES-GCM/PBKDF2-SHA256';
    }

    function validTextMessageCreate() {
      return request.resource.data.keys().hasOnly([
          'encrypted',
          'senderId',
          'createdAt',
          'seenBy',
          'seenAtBy',
          'reactions',
          'selfDestructAt',
          'type',
          'clientNonce'
        ])
        && request.resource.data.type == 'text'
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.reactions is list
        && request.resource.data.clientNonce is string
        && validSeenState()
        && validEncryptedPayload()
        && (
          !request.resource.data.keys().hasAny(['selfDestructAt'])
          || request.resource.data.selfDestructAt is string
        );
    }

    function validMediaMessageCreate() {
      return request.resource.data.keys().hasOnly([
          'senderId',
          'mediaUrl',
          'caption',
          'createdAt',
          'seenBy',
          'seenAtBy',
          'reactions',
          'type',
          'clientNonce'
        ])
        && (request.resource.data.type == 'image' || request.resource.data.type == 'voice')
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.clientNonce is string
        && request.resource.data.mediaUrl is string
        && (
          request.resource.data.mediaUrl.matches('^https://.*')
          || request.resource.data.mediaUrl.matches('^data:image/(jpeg|jpg|png|webp|gif);base64,.*')
        )
        && (
          !request.resource.data.keys().hasAny(['caption'])
          || (
            request.resource.data.caption is string
            && request.resource.data.caption.size() <= 2000
          )
        )
        && request.resource.data.reactions is list
        && validSeenState();
    }

    function validMessageUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.senderId == resource.data.senderId
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && changed.hasOnly(['seenBy', 'seenAtBy', 'reactions']);
    }

    function callParticipant() {
      return resource.data.callerId == request.auth.uid
        || resource.data.calleeId == request.auth.uid;
    }

    function validCallStatus(value) {
      return value == 'creating'
        || value == 'ringing'
        || value == 'connecting'
        || value == 'connected'
        || value == 'reconnecting'
        || value == 'declined'
        || value == 'missed'
        || value == 'ended'
        || value == 'failed';
    }

    function validCallTransition() {
      let before = resource.data.status;
      let after = request.resource.data.status;

      return before == after
        || (before == 'creating' && after == 'ringing' && request.auth.uid == resource.data.callerId)
        || (before == 'creating' && after == 'ended' && request.auth.uid == resource.data.callerId)
        || (before == 'creating' && after == 'failed' && request.auth.uid == resource.data.callerId)
        || (before == 'ringing' && after == 'connecting' && request.auth.uid == resource.data.calleeId)
        || (before == 'ringing' && after == 'declined' && request.auth.uid == resource.data.calleeId)
        || (before == 'ringing' && after == 'missed' && request.auth.uid == resource.data.callerId)
        || (before == 'ringing' && after == 'ended' && request.auth.uid == resource.data.callerId)
        || (before == 'connecting' && (after == 'connected' || after == 'reconnecting' || after == 'ended' || after == 'failed'))
        || (before == 'connected' && (after == 'reconnecting' || after == 'ended' || after == 'failed'))
        || (before == 'reconnecting' && (after == 'connecting' || after == 'connected' || after == 'ended' || after == 'failed'));
    }

    function validCallUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && validCallStatus(request.resource.data.status)
        && validCallTransition()
        && changed.hasOnly([
          'offer',
          'answer',
          'status',
          'expiresAt',
          'answeredAt',
          'connectedAt',
          'endedAt',
          'endedBy',
          'endReason',
          'restartRevision',
          'restartRequestedBy',
          'restartOffer',
          'restartAnswer',
          'restartStartedAt'
        ])
        && (
          !changed.hasAny(['offer'])
          || request.auth.uid == resource.data.callerId
        )
        && (
          !changed.hasAny(['answer'])
          || request.auth.uid == resource.data.calleeId
        )
        && (
          !changed.hasAny(['expiresAt'])
          || (
            request.auth.uid == resource.data.calleeId
            && resource.data.status == 'ringing'
            && request.resource.data.expiresAt == null
          )
        )
        && (
          !changed.hasAny(['restartOffer', 'restartRevision'])
          || request.auth.uid == resource.data.callerId
        )
        && (
          !changed.hasAny(['restartAnswer'])
          || request.auth.uid == resource.data.calleeId
          || (
            request.auth.uid == resource.data.callerId
            && request.resource.data.restartAnswer == null
          )
        )
        && (
          !changed.hasAny(['restartRequestedBy'])
          || request.resource.data.restartRequestedBy == null
          || request.resource.data.restartRequestedBy == request.auth.uid
        )
        && (
          !changed.hasAny(['endedBy'])
          || request.resource.data.endedBy == null
          || request.resource.data.endedBy == request.auth.uid
        );
    }

    function validIceCandidate() {
      return request.resource.data.keys().hasOnly([
          'candidate',
          'sdpMid',
          'sdpMLineIndex',
          'usernameFragment',
          'revision'
        ])
        && request.resource.data.candidate is string
        && request.resource.data.revision is number;
    }

    match /couples/{coupleId} {
      allow get: if signedIn()
        && (
          coupleMember(coupleId)
          || !resource.data.keys().hasAny(['memberCount'])
          || resource.data.memberCount < 2
        );
      allow list: if false;

      allow create: if signedIn() && validRoomCreate(coupleId);

      allow update: if validLegacyMembershipMigration() || validSecondMemberJoin();

      allow delete: if coupleMember(coupleId)
        && resource.data.createdBy == request.auth.uid;

      match /members/{userId} {
        allow get: if signedIn() && (request.auth.uid == userId || coupleMember(coupleId));
        allow list: if coupleMember(coupleId);
        allow create: if validMemberCreate(coupleId, userId);
        allow update: if signedIn()
          && request.auth.uid == userId
          && coupleMember(coupleId)
          && validMemberUpdate();
        allow delete: if false;

        match /devices/{deviceId} {
          allow get, list: if signedIn()
            && request.auth.uid == userId
            && coupleMember(coupleId);

          allow create, update: if signedIn()
            && request.auth.uid == userId
            && coupleMember(coupleId)
            && request.resource.data.keys().hasOnly([
              'targetId',
              'targetType',
              'platform',
              'enabled',
              'updatedAt'
            ])
            && request.resource.data.targetId is string
            && request.resource.data.targetId.size() > 10
            && request.resource.data.targetId.size() < 4096
            && (
              request.resource.data.targetType == 'fid'
              || request.resource.data.targetType == 'token'
            )
            && request.resource.data.platform is string
            && request.resource.data.enabled is bool;

          allow delete: if signedIn()
            && request.auth.uid == userId
            && coupleMember(coupleId);
        }
      }

      match /messages/{messageId} {
        allow read: if coupleMember(coupleId);
        allow create: if coupleMember(coupleId) && (validTextMessageCreate() || validMediaMessageCreate());
        allow update: if coupleMember(coupleId) && validMessageUpdate();
        allow delete: if coupleMember(coupleId);
      }

      match /memories/{memoryId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /openWhen/{letterId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /bucketList/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /readTogether/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /watchParty/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /skyStars/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /skySignals/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /moodLanterns/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /sleepStates/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /skyStats/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /starTouches/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /rightNowPhotos/{itemId} {
        allow read, write: if coupleMember(coupleId);
      }

      match /calls/{callId} {
        allow create: if coupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'callerId',
            'calleeId',
            'type',
            'status',
            'offer',
            'answer',
            'createdAt',
            'expiresAt',
            'answeredAt',
            'connectedAt',
            'endedAt',
            'endedBy',
            'endReason',
            'restartRevision',
            'restartRequestedBy',
            'restartOffer',
            'restartAnswer',
            'restartStartedAt'
          ])
          && request.resource.data.callerId == request.auth.uid
          && request.resource.data.calleeId != request.auth.uid
          && exists(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.resource.data.calleeId))
          && request.resource.data.status == 'creating'
          && (request.resource.data.type == 'audio' || request.resource.data.type == 'video')
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.restartRevision == 0;

        allow read: if coupleMember(coupleId) && callParticipant();

        allow update: if coupleMember(coupleId)
          && callParticipant()
          && validCallUpdate();

        allow delete: if coupleMember(coupleId) && callParticipant();

        match /callerCandidates/{candidateId} {
          allow read: if coupleMember(coupleId)
            && get(/databases/$(database)/documents/couples/$(coupleId)/calls/$(callId)).data.calleeId == request.auth.uid;

          allow create: if coupleMember(coupleId)
            && get(/databases/$(database)/documents/couples/$(coupleId)/calls/$(callId)).data.callerId == request.auth.uid
            && validIceCandidate();

          allow update: if false;

          allow delete: if coupleMember(coupleId)
            && (
              get(/databases/$(database)/documents/couples/$(coupleId)/calls/$(callId)).data.callerId == request.auth.uid
              || get(/databases/$(database)/documents/couples/$(coupleId)/calls/$(callId)).data.calleeId == request.auth.uid
            );
        }

        match /calleeCandidates/{candidateId} {
          allow read: if coupleMember(coupleId)
            && get(/databases/$(database)/documents/couples/$(coupleId)/calls/$(callId)).data.callerId == request.auth.uid;

          allow create: if coupleMember(coupleId)
            && get(/databases/$(database)/documents/couples/$(coupleId)/calls/$(callId)).data.calleeId == request.auth.uid
            && validIceCandidate();

          allow update: if false;

          allow delete: if coupleMember(coupleId)
            && (
              get(/databases/$(database)/documents/couples/$(coupleId)/calls/$(callId)).data.callerId == request.auth.uid
              || get(/databases/$(database)/documents/couples/$(coupleId)/calls/$(callId)).data.calleeId == request.auth.uid
            );
        }
      }

      match /callHistory/{historyId} {
        allow read: if coupleMember(coupleId);

        allow create: if coupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'callerId',
            'calleeId',
            'type',
            'result',
            'startedAt',
            'connectedAt',
            'durationSeconds',
            'endedAt'
          ])
          && (
            request.resource.data.callerId == request.auth.uid
            || request.resource.data.calleeId == request.auth.uid
          )
          && exists(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.resource.data.callerId))
          && exists(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.resource.data.calleeId))
          && request.resource.data.callerId != request.resource.data.calleeId
          && (request.resource.data.type == 'audio' || request.resource.data.type == 'video')
          && (
            request.resource.data.result == 'completed'
            || request.resource.data.result == 'declined'
            || request.resource.data.result == 'missed'
            || request.resource.data.result == 'failed'
            || request.resource.data.result == 'cancelled'
          )
          && request.resource.data.durationSeconds is number
          && request.resource.data.durationSeconds >= 0;

        allow update: if coupleMember(coupleId)
          && (
            resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid
          )
          && request.resource.data.callerId == resource.data.callerId
          && request.resource.data.calleeId == resource.data.calleeId
          && request.resource.data.type == resource.data.type
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'result',
            'startedAt',
            'connectedAt',
            'durationSeconds',
            'endedAt'
          ]);

        allow delete: if coupleMember(coupleId)
          && (
            resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid
          );
      }
    }
  }
}
