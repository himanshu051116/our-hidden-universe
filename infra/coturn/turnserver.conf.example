# Reference-only coturn configuration fragment for OHS.
# Do not deploy this verbatim without firewall/TLS/network review.

fingerprint
use-auth-secret

# Must equal the Vercel TURN_SHARED_SECRET.
static-auth-secret=REPLACE_WITH_LONG_RANDOM_SECRET

# Use a hostname you control.
realm=turn.example.com
server-name=turn.example.com

# Standard TURN listener. Add TLS certificate configuration for turns: support.
listening-port=3478
tls-listening-port=5349

# Basic abuse controls. Tune for your expected number of users.
user-quota=4
total-quota=200
stale-nonce=600

no-multicast-peers
no-cli

# Production deployment still needs:
# - a public IP / correct external-ip configuration when behind NAT
# - UDP + TCP firewall rules
# - TLS cert/key for turns:
# - monitoring and bandwidth limits
# - relay port-range configuration appropriate to the host firewall
